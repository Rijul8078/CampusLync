# Confirm these before launch. No invented defaults are used.
NEXT_PUBLIC_SITE_URL=
BUSINESS_LEGAL_NAME=
BUSINESS_CONTACT_EMAIL=
BUSINESS_POSTAL_ADDRESS=
# Optional HTTPS link from Calendly, Cal.com or another confirmed provider.
NEXT_PUBLIC_BOOKING_URL=
# Admin stays disabled until all three values are configured. Use a 32+ character random secret.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# PostgreSQL persistence. Run npm run db:migrate after configuring.
DATABASE_URL=
# Random 32+ character secret used to hash rate-limit identifiers. Raw IPs are not stored.
RATE_LIMIT_SECRET=
# Optional Resend notification after an enquiry is stored.
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_TO=
ENQUIRY_FROM_EMAIL=
# Confirm with the final privacy policy and schedule npm run db:cleanup.
DATA_RETENTION_DAYS=180
LEGAL_REVIEW_COMPLETE=false
